rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Documentación de casos: solo usuarios autenticados
    match /documentacion/{casoId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024  // máx 15 MB
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('image/.*'));
    }

    // Casos externos (iniciados fuera del sistema)
    match /casos_externos/{caseId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('image/.*'));
    }

  }
}
